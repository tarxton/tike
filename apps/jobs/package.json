{
  "name": "@tike/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "crawl": "tsx --env-file=../../.env.local src/crawl.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "match": "tsx --env-file=../../.env.local src/match.ts",
    "images": "tsx --env-file=../../.env.local src/images.ts",
    "images:ci": "tsx src/images.ts",
    "list-shops": "tsx --env-file=../../.env.local src/list-shops.ts",
    "list-shops:ci": "tsx src/list-shops.ts",
    "check-env": "tsx --env-file=../../.env.local src/check-env.ts",
    "check-env:ci": "tsx src/check-env.ts",
    "crawl:ci": "tsx src/crawl.ts",
    "match:ci": "tsx src/match.ts",
    "renormalize": "tsx --env-file=../../.env.local src/renormalize-images.ts",
    "renormalize:ci": "tsx src/renormalize-images.ts",
    "sweep": "tsx --env-file=../../.env.local src/sweep-renditions.ts"
  },
  "dependencies": {
    "@tike/contracts": "workspace:*",
    "@tike/core": "workspace:*",
    "@tike/crawler": "workspace:*",
    "@tike/db": "workspace:*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

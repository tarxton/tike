# Copy to .env.local and fill in. Never commit real values.
#
# The DATABASE_* variables are written for you by the Neon CLI:
#   neon checkout <branch>     # creates/switches branch and pulls its env
#   neon env pull              # re-pull the current branch's env
# Local development runs against a Neon *branch*, never the production branch.

# --- Site ---------------------------------------------------------------
# Display name is a single constant so the brand can change without a refactor.
SITE_NAME="tike"
SITE_URL="http://localhost:3000"

# --- Database (Neon, managed by the CLI) --------------------------------
# Written by `neon env pull`. Pooled URL for the app, unpooled for migrations.
NEON_BRANCH=""
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# --- Crawler ------------------------------------------------------------
# Identifies the crawler to shops. Must point at a real contact page before
# any crawl beyond local testing.
CRAWLER_USER_AGENT="tike-bot/0.1 (+https://tike.example/bot)"
CRAWLER_CONTACT_EMAIL="you@example.com"
# Politeness defaults; per-shop values in the `shop` table override these.
CRAWLER_MAX_CONCURRENCY_PER_DOMAIN="2"
CRAWLER_MIN_DELAY_MS="1000"

# --- Storage (Cloudflare R2) — Phase 2 ----------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="tike-media"

# --- Admin auth ---------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

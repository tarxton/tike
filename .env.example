# Copy to .env.local and fill in. Never commit real values.
#
# The DATABASE_* variables are written for you by the Neon CLI:
#   neon checkout <branch>     # creates/switches branch and pulls its env
#   neon env pull              # re-pull the current branch's env
# Local development runs against a Neon *branch*, never the production branch.

# --- Site ---------------------------------------------------------------
# Display name is a single constant so the brand can change without a refactor.
SITE_NAME="tike"
SITE_URL="http://localhost:3000"

# Extra origins allowed to load dev-only assets, comma separated. Needed to open
# `next dev` from another device: the dev server serves its client chunks only to
# the origin it was started on, so a phone on the LAN gets the HTML with every
# script 403ing and nothing hydrates. Development only.
DEV_ORIGINS="192.168.1.6"

# --- Database (Neon, managed by the CLI) --------------------------------
# Written by `neon env pull`. Pooled URL for the app, unpooled for migrations.
NEON_BRANCH=""
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# --- Crawler ------------------------------------------------------------
# Identifies the crawler to shops. Must point at a real contact page before
# any crawl beyond local testing.
CRAWLER_USER_AGENT="tike-bot/0.1 (+https://tike.example/bot)"
CRAWLER_CONTACT_EMAIL="you@example.com"
# Politeness defaults; per-shop values in the `shop` table override these.
CRAWLER_MAX_CONCURRENCY_PER_DOMAIN="2"
CRAWLER_MIN_DELAY_MS="1000"

# --- Storage (Cloudflare R2) — Phase 2 ----------------------------------
# Product images are copied here rather than hotlinked: a hotlinked card puts a request
# on a retailer's server on every page view, and Djak serves images only to its own pages,
# so its cards render broken without this. Create a bucket and an API token under R2 at
# dash.cloudflare.com, then enable public access (r2.dev) or attach a custom domain and
# put that address in R2_PUBLIC_BASE_URL. Free tier: 10 GB, no egress charge.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="tike-media"
# Where the stored objects are readable from, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=""

# --- Admin auth ---------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
